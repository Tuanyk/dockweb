# Docker Web Server Configuration
# IMPORTANT: Copy this to .env and change all passwords before deploying!
# cp .env.example .env

# --- PHP Configuration (auto-calculated by dockweb from site count) ---
# UID/GID for www-data inside PHP containers (match your deploy user)
# Run 'id' on your server to find your UID/GID (usually 1000)
PHP_UID=1000
PHP_GID=1000

# --- Database Configuration ---
DB_ROOT_PASSWORD=CHANGE_ME_TO_RANDOM_32_CHAR_STRING
# TODO: Change MySQL password to 32+ character random string

# --- Backup Configuration ---
RESTIC_PASSWORD=CHANGE_ME_TO_RANDOM_32_CHAR_STRING
# TODO: Change Restic password to 32+ character random string

# Alert email for backup/monitoring failures (optional)
ALERT_EMAIL=

# Backup schedule (cron format), timezone, and retention policy.
# BACKUP_TIMEZONE is an IANA name (e.g. UTC, Asia/Ho_Chi_Minh, America/New_York).
# It controls when BACKUP_SCHEDULE fires — '0 3 * * *' + 'Asia/Ho_Chi_Minh' = 3 AM UTC+7.
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_TIMEZONE="UTC"
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# Optional offsite backup. Configure rclone first with:
#   ./dockweb backup setup-drive
# Then set OFFSITE_BACKUP_REMOTE to your remote path, for example:
#   gdrive:dockweb-backups/repo
BACKUP_NOTIFY_NAME=dockweb
OFFSITE_BACKUP_ENABLED=false
OFFSITE_BACKUP_REMOTE=
# sync mirrors local retention to Drive; copy never deletes remote files but uses more storage.
OFFSITE_BACKUP_MODE=sync
RCLONE_TRANSFERS=4
RCLONE_CHECKERS=8

# Optional Telegram notifications.
# Add the bot to your channel/group and set the chat id or @public_channel_username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram health alerts are separate from backup Telegram messages.
# Configure interactively with: ./dockweb alerts setup
TELEGRAM_ALERTS_ENABLED=false
HEALTHCHECK_NOTIFY_NAME=dockweb
ALERT_CONTAINER_CHECKS_ENABLED=true
ALERT_CPU_PERCENT=85
ALERT_CPU_SAMPLE_SECONDS=1
ALERT_MEMORY_PERCENT=90
ALERT_SWAP_PERCENT=50
ALERT_DISK_PERCENT=85
ALERT_DISK_CHECKS=1
# Sustained checks are counted by monitoring/healthcheck.sh; cron runs every 5 minutes by default.
ALERT_SUSTAINED_CHECKS=2
ALERT_SITE_CHECKS_ENABLED=true
ALERT_SITE_FAILURE_CHECKS=2
ALERT_SITE_TIMEOUT=8
ALERT_SITE_PATH=/health
ALERT_SKIP_LOCAL_SITES=true
ALERT_SSL_CHECKS_ENABLED=true
ALERT_SSL_EXPIRY_DAYS=14
ALERT_TRAFFIC_CHECKS_ENABLED=true
ALERT_TRAFFIC_WINDOW_MINUTES=5
ALERT_TRAFFIC_RPM=300
ALERT_TRAFFIC_CHECKS=1
ALERT_TOP_IP_REQS_PER_INTERVAL=500
ALERT_5XX_PER_INTERVAL=20
ALERT_4XX_PER_INTERVAL=200

# --- SSL/Certbot Configuration ---
CERTBOT_EMAIL=your-email@example.com
# TODO: Change to your actual email address

# --- Cloudflare Configuration (multi-account) ---
# Name each account with [A-Za-z0-9_] (no hyphens/dots — they break env var names).
# When a site is added with SSL mode "cloudflare", dockweb probes each account
# in order and uses the first one whose zones cover the domain.
CLOUDFLARE_ACCOUNTS=

# For each name in CLOUDFLARE_ACCOUNTS, set:
#   CLOUDFLARE_API_TOKEN_<name>     — token with Zone:Read (zone lookup)
#   CLOUDFLARE_ORIGIN_CA_KEY_<name> — Origin CA Key (cert issuance, different
#                                     from the API token; looks like v1.0-…)
# API tokens:     https://dash.cloudflare.com/profile/api-tokens
# Origin CA Key:  https://dash.cloudflare.com/profile/api-tokens > Origin CA Key
#
# Example for two accounts named "personal" and "work":
#   CLOUDFLARE_ACCOUNTS=personal,work
#   CLOUDFLARE_API_TOKEN_personal=...
#   CLOUDFLARE_ORIGIN_CA_KEY_personal=v1.0-...
#   CLOUDFLARE_API_TOKEN_work=...
#   CLOUDFLARE_ORIGIN_CA_KEY_work=v1.0-...

# Legacy single-account fallback: if CLOUDFLARE_ACCOUNTS is empty and these
# are set, dockweb treats them as a synthetic "default" account.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ORIGIN_CA_KEY=

# --- Glances Monitoring ---
GLANCES_USERNAME=admin
GLANCES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
# TODO: Change Glances password to strong password

# --- Resource Limits ---
MYSQL_INNODB_BUFFER_POOL_SIZE=512M
PHP_PM_MAX_CHILDREN=3
REDIS_MAXMEMORY=256mb
BACKUP_ENABLED=false
# Comma-separated list of domains to exclude from backup (e.g., dev.example.com,staging.example.com)
BACKUP_EXCLUDE_SITES=
