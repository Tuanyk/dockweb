# Website source code (managed separately with their own git repos)
sites/*/
!sites/*/.dockweb.conf

# Broker instances (per-deployment, generated from templates/)
brokers/*/

# Environment (contains passwords)
.env

# Auto-generated (regenerated by dockweb on start)
docker-compose.sites.yml
docker-compose.brokers.yml
nginx/conf.d/*.conf
!nginx/conf.d/00-default.conf

# Runtime data
mysql/data/
logs/
backups/
rclone/
nginx/cache/

# SSL certificates (sensitive)
certbot/conf/
certbot/www/
certbot/logs/
cloudflare-certs/*/
local-certs/*/

# Docker
*.log

# Private docs (promotion plans, notes)
docs/

# OS
.DS_Store
Thumbs.db
.codex


AGENTS.md
CLAUDE.md
mysql/